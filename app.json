{
  "expo": {
    "name": "Scalar",
    "slug": "aether",
    "owner": "atikmahbub100",
    "version": "4.2.0",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "scheme": "aether",
    "icon": "./assets/icons/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FFFFFF",
    "splash": {
      "backgroundColor": "#FFFFFF",
      "resizeMode": "contain",
      "dark": {
        "backgroundColor": "#04050A"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.atik.aether",
      "backgroundColor": "#FFFFFF",
      "infoPlist": {
        "CFBundleDisplayName": "Scalar",
        "UIViewControllerBasedStatusBarAppearance": true,
        "NSFaceIDUsageDescription": "Use Face ID to securely unlock your wallet."
      },
      "icon": {
        "light": "./assets/icons/ios/icon-light.png",
        "dark": "./assets/icons/ios/icon-dark.png",
        "tinted": "./assets/icons/ios/icon-tinted.png"
      }
    },
    "android": {
      "package": "com.atik.aether",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "backgroundColor": "#FFFFFF",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/android/adaptive-icon-foreground.png",
        "backgroundImage": "./assets/icons/android/adaptive-icon-background.png",
        "backgroundColor": "#0A0F1C",
        "monochromeImage": "./assets/icons/android/monochrome-icon.png"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/icons/web/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "./plugins/withAndroidTransparentSplashIcon",
      "./plugins/withIosPodMinDeploymentTarget",
      "./plugins/withIosSceneLifecycle",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/splash/splash-icon-light.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/icons/splash/splash-icon-dark.png",
            "backgroundColor": "#04050A"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icons/android/notification-icon.png",
          "color": "#C84B31"
        }
      ],
      "expo-sqlite"
    ],
    "extra": {
      "auth0Domain": "dev-pm0712stgt281lme.us.auth0.com",
      "auth0ClientId": "ZKFTcNI7NKpHeAv11HY5qQjCIpkddOH9",
      "auth0Audience": "https://api.tracking-wallet.com",
      "router": {},
      "eas": {
        "projectId": "f6321d98-7753-456b-b4c8-61857344a854"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "newArchEnabled": false
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f6321d98-7753-456b-b4c8-61857344a854"
    }
  }
}
